<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <UseWPF Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</UseWPF>
    <UseWindowsForms Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</UseWindowsForms>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Audit findings stay warnings: an advisory published after this source was written must never fail the build. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Codexish.Server</RootNamespace>
    <AssemblyName>Codexish.Server</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows Forms' implicit usings would make WPF and System.Drawing type names ambiguous; the tray aliases them. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
</Project>
